generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // Supabase direct/session connection (migrations)
}

model Car {
  id           String  @id @default(cuid())
  name         String
  brand        String
  pricePerDay  Int
  category     String
  image        String
  seats        Int
  transmission String
  fuel         String
  available    Boolean @default(true)
}

model Booking {
  id        String   @id @default(cuid())
  carName   String
  fullName  String
  phone     String
  startDate DateTime
  endDate   DateTime
  status    String   @default("pending")
}

model Contact {
  id      String @id @default(cuid())
  name    String
  phone   String
  message String
}
